# 复制成 .env 后填入真实值。
#
# `.env` 已在 .gitignore 里（用通配规则 `.env.*`，不是逐条列举）。
# 🔴 本文件是**唯一**的配置真源说明：代码里不留任何真实默认值，
#    缺哪一项由 `run_e2e.py --doctor` / `config.validate()` 显式报出来。

# ── 收信：CF Temp Email Worker（必填）────────────────────────────────
# 管理密钥：建邮箱 / 走 /admin/* 端点用
TEMPMAIL_ADMIN_KEY=
# Worker 的根地址，形如 https://<你的-worker-子域>.workers.dev
TEMPMAIL_BASE=
# 建临时邮箱用哪个域名（必须是 Worker /health 里 domains 之一）
TEMPMAIL_DOMAIN=

# ── Token Juice 站点与网关（选填，已有公开默认值）─────────────────────
# 控制面：发链接 / 换会话 / 建 key
# SITE_ORIGIN 写死在 src/config.py（站点只有这一个入口，不需要可配）
# 数据面：验活用的推理网关
TOKENJUICE_API_ORIGIN=https://api.tokenjuice.ai/v1
# 验活用的模型（站点当前唯一公开模型）
TOKENJUICE_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
